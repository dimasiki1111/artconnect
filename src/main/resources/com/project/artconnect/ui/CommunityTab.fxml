<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.CommunityController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <!-- Search Bar -->
    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Chercher un membre..." HBox.hgrow="ALWAYS" />
        <Button text="Rechercher" onAction="#handleSearch" />
        <Button text="Réinitialiser" onAction="#handleReset" />
    </HBox>
    
    <!-- CRUD Buttons -->
    <HBox spacing="10.0">
        <Button text="Ajouter un Membre" onAction="#handleAddMember" />
        <Button text="Modifier le Membre" onAction="#handleEditMember" />
        <Button text="Supprimer le Membre" onAction="#handleDeleteMember" />
    </HBox>
    
    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="250" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250" />
            <TableColumn fx:id="cityColumn" text="City" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
