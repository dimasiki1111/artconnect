<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <!-- Search Bar -->
    <HBox spacing="10.0">
        <TextField fx:id="searchField" promptText="Chercher un atelier..." HBox.hgrow="ALWAYS" />
        <Button text="Rechercher" onAction="#handleSearch" />
        <Button text="Réinitialiser" onAction="#handleReset" />
    </HBox>
    
    <!-- CRUD Buttons -->
    <HBox spacing="10.0">
        <Button text="Ajouter un Atelier" onAction="#handleAddWorkshop" />
        <Button text="Modifier l'Atelier" onAction="#handleEditWorkshop" />
        <Button text="Supprimer l'Atelier" onAction="#handleDeleteWorkshop" />
    </HBox>
    
    <!-- Table -->
    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Titre" prefWidth="200" />
            <TableColumn fx:id="instructorColumn" text="Instructeur" prefWidth="150" />
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
            <TableColumn fx:id="priceColumn" text="Prix" prefWidth="80" />
            <TableColumn fx:id="levelColumn" text="Niveau" prefWidth="100" />
        </columns>
    </TableView>
</VBox>
